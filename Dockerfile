FROM node:20-bookworm-slim
WORKDIR /app

# Create the complete SABHAN AI project from this single Dockerfile.
RUN mkdir -p /app/public /app/uploads
RUN echo  | base64 -d > /app/package.json
RUN echo  | base64 -d > /app/server.js
RUN echo T1BFTkFJX0FQSV9LRVk92LbYuV/ZhdmB2KrYp9itX09wZW5BSV/Zh9mG2KcKUE9SVD0zMDAwCk1BWF9JTUFHRV9NQj0xMAo= | base64 -d > /app/.env.example
RUN mkdir -p /app/public
RUN echo  | base64 -d > /app/public/index.html
RUN mkdir -p /app/public
RUN echo  | base64 -d > /app/public/style.css
RUN mkdir -p /app/public
RUN echo  | base64 -d > /app/public/app.js

RUN npm install --omit=dev
ENV NODE_ENV=production
EXPOSE 3000
CMD ["node", "server.js"]
